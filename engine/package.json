{
  "name": "@roborally/engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "TypeScript port of the RoboRally rules engine, runs in the authoritative host browser",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "build": "esbuild src/index.ts --bundle --format=esm --outfile=dist/roborally-engine.js"
  },
  "devDependencies": {
    "esbuild": "^0.24.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
